# 只保存"环境变量名"，不保存任何密钥值；配置文件里同样只写变量名。
# P0 离线闭环不需要以下任何一项；P1/P3 才使用。

# P3 选择性 LLM（可选，默认关闭）
XHS_LLM_ENDPOINT=
XHS_LLM_API_KEY=

# P1 xhs-search CLI 的调用参数：本项目代码只从 config/*.yaml 的 sources.xhs_search 读取
# node_path / cli_path / profile / browser / lock_dir，不读取以下环境变量，保留仅作记录。
# 想跑 live 模式请直接改配置文件里的绝对路径。
XHS_SEARCH_NODE=node
XHS_SEARCH_CLI_PATH=
XHS_SEARCH_PROFILE=
XHS_SEARCH_BROWSER=

# 浏览器 profile 与登录态由 CLI 自己管理：本项目不读取、不复制、不打印其中的 cookie。
